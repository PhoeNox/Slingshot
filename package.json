{
  "name": "slingshot",
  "version": "0.1.0",
  "private": true,
  "description": "Browser port of Slingshot, the two-player gravity artillery game",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings && stylelint \"src/**/*.css\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0"
  }
}
